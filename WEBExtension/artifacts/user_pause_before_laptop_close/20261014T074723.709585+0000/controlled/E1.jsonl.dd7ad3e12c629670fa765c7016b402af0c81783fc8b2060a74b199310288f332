Silicon Valley in Mountain View, California."," It was established in 2002 at the NASA Ames Research Center in Moffett Field."," The campus offers full-time and part-time professional Masters programs in Electrical And Computer Engineering, Software Engineering and Software Management, various bi-coastal (split-time between Pittsburgh and Silicon Valley) Masters programs in Information Technology, and a bi-coastal Ph.D. program in Electrical and Computer Engineering."," One key differentiator between programs in the traditional Pittsburgh campus and the new Silicon Valley campus is a new focus on project-centered \"learning by doing\" approach to education."],"title":"Carnegie Mellon Silicon Valley"}],"responses":[{"answer":"noanswer","cache_hit":false,"call_key":"0751c3b5456bf05fa7cc257ad4dd38d5899525892186825005a38095fcad9715","citations":[],"input_tokens":1288,"invalid_citations":[],"latency_seconds":1.2232758030004334,"output_tokens":167,"provider_refusal":false,"provider_refusal_reason":null,"provider_usage":{"audio_prompt_tokens":0,"completion_tokens":167,"completion_tokens_details":null,"prompt_tokens":1288,"prompt_tokens_details":null,"total_tokens":1455},"raw_text":"{\n  \"answer\": \"noanswer\",\n  \"citations\": []\n}","returned_model":"gpt-oss-120b"},{"answer":"noanswer","cache_hit":false,"call_key":"a7983f39d3627c8147c8e16edac4e30f7239e519d3b95ac95a0e7d4034289f4a","citations":[],"input_tokens":1288,"invalid_citations":[],"latency_seconds":0.7731376020001335,"output_tokens":158,"provider_refusal":false,"provider_refusal_reason":null,"provider_usage":{"audio_prompt_tokens":0,"completion_tokens":158,"completion_tokens_details":null,"prompt_tokens":1288,"prompt_tokens_details":null,"total_tokens":1446},"raw_text":"{\n  \"answer\": \"noanswer\",\n  \"citations\": []\n}","returned_model":"gpt-oss-120b"},{"answer":"noanswer","cache_hit":false,"call_key":"1c40206f88e3d9b922e525a47585e4d430895a538ec5325ce970bfde24686755","citations":[],"input_tokens":1288,"inval